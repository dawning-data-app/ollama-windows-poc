(version 1)
(deny default)
(import "system.sb")
(allow syscall* mach-bootstrap process-exec process-fork sysctl-read)
(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))
(allow file-read-metadata file-test-existence)
(allow mach-lookup (global-name "com.apple.bsd.dirhelper") (global-name "com.apple.system.opendirectoryd.libinfo") (global-name "com.apple.SystemConfiguration.configd"))
(allow file-read* file-map-executable
 (subpath "/bin")
 (subpath "/sbin")
 (subpath "/usr/bin")
 (subpath "/usr/sbin")
 (subpath "/opt/homebrew")
 (subpath "/Users/andrew/.local/share/uv/python/cpython-3.12.12-macos-aarch64-none")
 (subpath "/private/tmp/local-excel-poc/opencode")
)
(allow file-read* file-write* file-map-executable
 (subpath "/private/tmp/local-excel-extensions/runs/isolated/20261105T091434-ecdfbe5e/workspace")
 (subpath "/private/tmp/local-excel-extensions/runs/isolated/20261105T091434-ecdfbe5e/tmp")
 (subpath "/private/tmp/local-excel-extensions/runs/isolated/20261105T091434-ecdfbe5e/config")
 (subpath "/private/tmp/local-excel-extensions/runs/isolated/20261105T091434-ecdfbe5e/cache")
 (subpath "/private/tmp/local-excel-extensions/runs/isolated/20261105T091434-ecdfbe5e/state")
)
(allow file-read* file-write* file-ioctl (subpath "/dev"))
(allow file-read-data (literal "/private/etc/hosts") (literal "/private/etc/resolv.conf") (literal "/private/etc/apache2/mime.types"))
(allow network-outbound (remote ip "localhost:11434"))
(allow network-bind network-inbound (local ip "localhost:*"))
